package-as: HandyNotes_LegionClassOrderHalls

manual-changelog:
    filename: Docs/ChangeLog.txt
    markup-type: plain
    
enable-nolib-creation: yes

externals:
    Libs-release/LibBabble-SubZone-3.0: 
        url: https://repos.wowace.com/wow/libbabble-subzone-3-0/trunk
    Libs-release/LibUIDropDownMenu: 
        url: https://repos.wowace.com/wow/libuidropdownmenu/trunk/LibUIDropDownMenu

move-folders:
    HandyNotes_LegionClassOrderHalls/Libs: HandyNotes_LegionClassOrderHalls/Libs-dev
    HandyNotes_LegionClassOrderHalls/Libs-release: HandyNotes_LegionClassOrderHalls/Libs
ignore:
    - Images/PSD
    - Libs-dev

